# Spotify API Configuration
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# Optional live visitor counter (Upstash Redis, or Vercel KV which uses the same REST API).
# Without these the footer shows the baseline from src/data/site.ts.
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# Optional: any random string, used to salt the visitor hash.
VISITOR_SALT=

# SEO (optional). The canonical site URL is taken from SITE_URL, then from Vercel's
# production domain, so it normally needs no setting.
SITE_URL=
# Paste the token from Google Search Console's "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=
